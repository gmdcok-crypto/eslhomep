# Copy to .env locally or set in Railway Variables
PORT=8080

# Comma-separated allowed browser origins
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://esl.bluecs.co.kr,https://eslsub.netlify.app

# MySQL (Railway MySQL plugin auto-injects MYSQL* variables)
# DATABASE_URL=mysql://user:pass@host:3306/dbname
# MYSQLHOST=...
# MYSQLPORT=3306
# MYSQLUSER=...
# MYSQLPASSWORD=...
# MYSQLDATABASE=...

# Local fallback when MySQL is not configured
# sqlite:///./data/inquiries.db

# Optional SMTP notification
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="e-PAPER <noreply@example.com>"
# INQUIRY_TO=sales@example.com

# Admin PWA (문의 조회/알림)
# ADMIN_API_KEY=your-long-random-secret

# Web Push (문의 접수 시 앱 닫혀 있어도 알림)
# 따옴표/공백 없이 한 줄로 넣으세요
# VAPID_PUBLIC_KEY=BFbsESQYQyrx8QiJQqn38gMx4erMBgZGbV0q3fMp6K7GcAxRw3A7yOMZPT6e8rqdTMeFsr2eyIGnCmL7cpvYO6g
# VAPID_PRIVATE_KEY=fHhSq09FBdzoy3b8hChKK-ZaPNLXkYs8t6zucKvTFZk
