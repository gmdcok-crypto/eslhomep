# Copy to .env locally or set in Railway Variables
PORT=8080
NODE_ENV=production

# Comma-separated Netlify site origins, e.g.
# https://signet-esl.netlify.app,https://esl.yourdomain.com
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Optional: persist path on Railway volume
# DATA_DIR=/data

# Optional SMTP notification
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="SIGNET ESL <noreply@example.com>"
# INQUIRY_TO=sales@example.com
